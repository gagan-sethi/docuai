# ─────────────────────────────────────────────────────────────────
# Invonix customer portal & website — public configuration
#
# Variables prefixed NEXT_PUBLIC_ are compiled into the browser bundle.
# Set them in Vercel (or your host) BEFORE building: changing one needs a
# rebuild, not just a restart.
# ─────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.invonix.ai

# Admin panel URL, used to return from an impersonation session
NEXT_PUBLIC_ADMIN_URL=https://admin.invonix.ai

# Google sign-in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# ─── Contact details (src/lib/siteConfig.ts) ─────────────────────
# One domain across the site, the portal and outbound email. Leaving these
# unset falls back to support@invonix.ai / hello@invonix.ai.
NEXT_PUBLIC_SUPPORT_EMAIL=support@invonix.ai
NEXT_PUBLIC_SALES_EMAIL=hello@invonix.ai
NEXT_PUBLIC_COMPANY_CITY=Dubai, UAE


# ─── WhatsApp intake (CB-09) ─────────────────────────────────────
# The verified WhatsApp Business number in E.164 form, digits only, no "+".
# LEAVE THIS EMPTY until a real number is provisioned: while it is empty
# every WhatsApp CTA, nav entry, dashboard card and onboarding step is
# hidden, instead of advertising a placeholder number beside "Coming soon".
# Example once live: 971501234567
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ─── Trial model (B-01) ──────────────────────────────────────────
# Days of free trial on paid plans. 0 (or unset) means "no trial", and the
# whole site then says "start free" instead of promising a trial the billing
# configuration does not grant. MUST match the trial setting on the plans in
# the admin panel — these two disagreeing was the source of the contradictory
# trial wording across the site, signup and FAQ.
NEXT_PUBLIC_TRIAL_DAYS=0


# ─── Surfaces that are not live yet ──────────────────────────────
# Blog: the WordPress source still holds template/lorem-ipsum posts. Set to
# "true" only once real articles are published (CB-05). While false, /blog
# and /blog/[slug] return 404 and the nav/footer entries are hidden.
NEXT_PUBLIC_ENABLE_BLOG=false

# Partner programme: needs an application page and published commission
# terms before the homepage section goes back up (UX-03).
NEXT_PUBLIC_ENABLE_PARTNER_PROGRAM=false

# Public API access: not exposed to customers yet (B-03).
NEXT_PUBLIC_ENABLE_PUBLIC_API=false


# ─── Signup ──────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE_PLACEHOLDER=+971 50 123 4567


# ─── Legal pages (src/lib/legalConfig.ts) ────────────────────────
# These appear verbatim in the published Privacy Policy, Terms of Service
# and Cookie Policy. They MUST match the company's trade licence before
# launch — have them checked by whoever signs off the legal text.
NEXT_PUBLIC_LEGAL_ENTITY=Invonix
NEXT_PUBLIC_TRADE_LICENCE=
NEXT_PUBLIC_REGISTERED_ADDRESS=Dubai, United Arab Emirates
NEXT_PUBLIC_GOVERNING_LAW=the United Arab Emirates
NEXT_PUBLIC_COURTS=the courts of Dubai, United Arab Emirates

# Where documents and extracted data are stored. Must match AWS_S3_REGION in
# the API service — UAE PDPL requires the cross-border transfer to be
# disclosed accurately in the Privacy Policy.
NEXT_PUBLIC_STORAGE_REGION=AWS ap-south-1 (Mumbai, India)
